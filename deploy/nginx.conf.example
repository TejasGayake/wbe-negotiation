# Example Nginx site for N8N Hiring - Negotiation
# Copy to /etc/nginx/sites-available/wbe_negotiation, adjust paths/domain, then:
#   ln -s /etc/nginx/sites-available/wbe_negotiation /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

upstream wbe_app {
    server 127.0.0.1:8000;        # gunicorn bind address (gunicorn.conf.py)
    keepalive 16;
}

server {
    listen 80;
    server_name negotiation.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name negotiation.example.com;

    ssl_certificate     /etc/letsencrypt/live/negotiation.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/negotiation.example.com/privkey.pem;

    client_max_body_size 2m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 500;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Static files are served directly by Nginx (never touch Python).
    location /static/ {
        alias /srv/wbe_negotiation/app/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Everything else goes to Gunicorn.
    location / {
        proxy_pass http://wbe_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
