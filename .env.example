# ---- Flask ----
FLASK_APP=wsgi.py
# Development | Production
FLASK_ENV=Development
# Dev server port (N8NHIRING v1.0 uses 5002)
FLASK_RUN_PORT=5001
SECRET_KEY=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wbe_user
DB_PASSWORD=change-me
DB_NAME=WARS

# Optional SSL for remote MySQL. Leave empty to disable.
# Path to the CA certificate file (e.g. /etc/ssl/certs/ca-cert.pem)
DB_SSL_CA=

# ---- Admin seed (used by `flask seed-admin`) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# ---- Business rule: target gross margin in percent (Healthy tier threshold) ----
TARGET_MARGIN=22

# ---- Optional: override a full SQLAlchemy URI (used by tests / SQLite) ----
# DATABASE_URL=
